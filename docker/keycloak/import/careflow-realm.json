{
  "realm": "careflow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "Patient qui soumet ses demandes de remboursement"
      },
      {
        "name": "admin",
        "description": "Admin qui valide manuellement les demandes PENDING"
      }
    ]
  },
  "defaultRoles": ["patient", "offline_access", "uma_authorization"],
  "clients": [
    {
      "clientId": "careflow-backend",
      "name": "CareFlow Backend (resource server)",
      "description": "Bearer-only. Ne fait jamais de login, valide juste les JWT.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "careflow-frontend",
      "name": "CareFlow Frontend (Angular SPA)",
      "description": "Public client avec PKCE. Redirect uniquement vers le dev server local.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@careflow.local",
      "firstName": "Alice",
      "lastName": "Patient",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": ["patient"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@careflow.local",
      "firstName": "Bob",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": ["patient", "admin"]
    }
  ]
}
